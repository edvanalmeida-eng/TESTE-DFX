  "structures": [
    {
      "id": "nao-so",
      "regex": "(?i)\\bnão (?:é|foi|são|era) (?:só|apenas|somente) [^.!?\\n]{2,60}[,.;] (?:é|foi|são|era)\\b",
      "name": "\"Não é só X, é Y\"",
      "fix": "Diga a coisa que você quer dizer. Corte a primeira metade."
    },
    {
      "id": "nao-apenas",
      "regex": "(?i)\\bnão (?:apenas|somente|só)\\b[^.!?\\n]{2,80}\\bmas também\\b",
      "name": "\"Não apenas X, mas também Y\"",
      "fix": "Quebre em duas frases ou corte a metade mais fraca."
    },
    {
      "id": "nao-sobre",
      "regex": "(?i)\\b(?:isso|isto|tudo isso) não (?:é|trata-se) (?:sobre|de) [^.!?\\n]{2,60}[.!] (?:é|trata-se) (?:sobre|de)\\b",
      "name": "\"Não é sobre X. É sobre Y.\"",
      "fix": "Comece pelo Y. A virada é o que denuncia."
    },
    {
      "id": "pergunta-seca",
      "regex": "(?i)^\\s*(?:o resultado|a melhor parte|o detalhe|o problema|a surpresa)\\?\\s*$",
      "name": "Pergunta retórica de uma linha",
      "fix": "Responda na própria frase em vez de montar suspense."
    },
    {
      "id": "aprendi",
      "regex": "(?i)\\bo que (?:eu )?aprendi com isso\\b",
      "name": "\"O que eu aprendi com isso\"",
      "fix": "Diga a lição. Pule o anúncio."
    },
    {
      "id": "triade",
      "regex": "(?i)\\b\\w+, \\w+ e \\w+\\.",
      "name": "Tríade (\"A, B e C.\")",
      "fix": "Dois itens ou quatro. Três é o ritmo padrão da IA."
    },
    {
      "id": "emoji-foguete",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Emoji de foguete, fogo, lâmpada, brilho ou alvo",
      "fix": "No máximo um emoji, e que não seja destes cinco."
    },
    {
      "id": "muro-hashtags",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Muro de hashtags (5+)",
      "fix": "Três hashtags. O LinkedIn parou de premiar o muro."
    },
    {
      "id": "vamos-la",
      "regex": "(?i)^\\s*(?:vamos lá|bora|então vamos)[:!.]?\\s*$",
      "name": "Abertura de uma linha",
      "fix": "Comece direto pelo assunto."
    }
  ]
}